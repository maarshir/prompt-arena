# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.
# Хватает одного ключа из двух.

# Бесплатный путь: ключ Groq (https://console.groq.com/keys).
# Если задан только он, прогон сам пойдёт через Groq на openai/gpt-oss-120b.
GROQ_API_KEY=

# Платный путь: ключ Anthropic.
ANTHROPIC_API_KEY=

# Необязательно. Модель по умолчанию (имя с косой чертой, например openai/gpt-oss-20b, уйдёт в Groq).
# PROMPTDIFF_MODEL=claude-sonnet-4-6
# Необязательно. Поставщик, если по имени модели не понять: groq или anthropic.
# PROMPTDIFF_PROVIDER=groq
# Необязательно. Не больше стольких запросов в минуту (у Groq по умолчанию 20, 0 без ограничения).
# PROMPTDIFF_RPM=20
